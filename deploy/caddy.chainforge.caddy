# Appended to ~/aurora/Caddyfile on us-2c2g (shared Caddy in aurora-web-1).
# Requires /root/chainforge/site mounted at /srv/chainforge.

chainforge.cn, www.chainforge.cn {
	encode zstd gzip

	@www host www.chainforge.cn
	redir @www https://chainforge.cn{uri} permanent

	# /product is a leftover client-side-only redirect stub in the Next app
	# (no server involved under static export). Redirect it here instead so
	# non-JS crawlers and link-preview bots get a real 301, not a blank shell.
	@product path /product /product/
	redir @product / permanent

	handle /_next/static/* {
		root * /srv/chainforge
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv/chainforge
		header Cache-Control "no-cache"
		try_files {path} {path}/index.html =404
		file_server
	}

	handle_errors {
		@404 expression {http.error.status_code} == 404
		rewrite @404 /404.html
		root * /srv/chainforge
		file_server
	}
}
